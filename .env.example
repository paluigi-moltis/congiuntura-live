# ─── Secrets only (loaded by Pydantic BaseSettings) ───────
# Application settings (poll interval, server, etc.) live in
# config/app.toml — this file is for secrets that must not be
# committed to version control.

MONGODB_URL=mongodb://mongo:27017
MONGODB_DATABASE=congiuntura

# ─── OpenRouter (primary LLM backend) ──────────────────────
# Sign up at https://openrouter.ai/ and get an API key.
OPENROUTER_API_KEY=sk-or-v1-your-key-here
